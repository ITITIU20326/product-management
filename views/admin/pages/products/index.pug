extends ../../layouts/default.pug

block main 
    .main-box
        h1 Trang danh sách sản phẩm 
        .card.mb-3
            .card-header Bộ lọc và tìm kiếm
            .card-body
                each product in fiterStatus
                    button(
                        class= `btn btn-sm ml-1 btn-outline-success ${product.class}`
                        button-status=product.status
                    ) #{product.name}
        .card.mb-3
            .card-header Danh sách sản phẩm
            .card-body
                table.table-hover.table-sm
                    thead
                        tr
                            th STT
                            th Hình ảnh
                            th Tiêu đề
                            th Giá
                            th Trạng thái
                            th Hành động
                    tbody
                        each product,index in products
                            tr
                                td #{index + 1}
                                td
                                    img(
                                        src=product.thumbnail 
                                        alt=product.title 
                                        width="100px" 
                                        height="auto")
                                td #{product.title}
                                td #{product.price}$
                                td
                                    if(product.status == "active")
                                        a(href="#" class="badge badge-success") Hoạt động     
                                    else
                                        a(href="#" class="badge badge-danger") Ngừng hoạt động
                                    
                                td
                                    button(class="btn btn-warning btn-sm") Sửa
                                    button(class="btn btn-danger btn-sm") Xóa